# Database (LOCAL — PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atelierone_erp"

# Auth (NextAuth v5 — utilise AUTH_SECRET)
AUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"
AUTH_RATE_LIMIT_MAX=5

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AtelierOne"
ADMIN_EMAIL="admin@atelierone.cm"

# Supabase cloud (facultatif — utilisé par scripts/deploy.mjs supabase)
# DATABASE_URL="postgresql://postgres.<ref>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require"
