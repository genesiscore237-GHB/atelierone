# Database — on bascule souvent entre LOCAL et NEON.
#   pnpm db:use-local   -> local
#   pnpm db:use-neon    -> cloud
#   pnpm db:current     -> affiche la cible active
# Le script met à jour : .env, apps/nextjs/.env.local, packages/db/.env

# LOCAL (commenté quand NEON est actif)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atelierone_erp"

# NEON (commenté quand LOCAL est actif) — le mot de passe ne se commit jamais
# DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require"

# Auth (NextAuth v5 — utilise AUTH_SECRET)
AUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"
AUTH_RATE_LIMIT_MAX=5

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AtelierOne"
ADMIN_EMAIL="admin@atelierone.cm"

# Vercel (à définir dans Settings > Environment Variables, en Production + Preview)
#   DATABASE_URL=<même URL Neon, avec sslmode=require>
#   AUTH_SECRET=<même secret qu'en local>
#   APP_ROLE=<site|central>  LICENCE_SECRET  SITE_CODE  SITE_CLE_API  CENTRAL_URL  (module licence, facultatif)
#   UPLOAD_DIR=<ignoré sur serverless, cf. audit §14>
